# Sunucuda deploy/.env olarak kopyalanır (chmod 600). Gerçek değerler git'e girmez.
POSTGRES_PASSWORD=""
SESSION_SECRET=""
# CRM erişim kapısı (HTTP Basic)
DEMO_ACCESS_USER="mirmotors"
DEMO_ACCESS_PASSWORD=""
# Alan adı ve HTTPS gelince 1 yapın
COOKIE_SECURE="0"
NEXT_PUBLIC_WHATSAPP_NUMBER="905000000000"
NEXT_PUBLIC_INSTAGRAM_URL=""

# Zorunlu ilan / işletme bilgileri (boşsa sitede "yayın öncesi eklenecek" yazar; CRM > Ayarlar'dan da girilebilir)
COMPANY_TITLE=""
COMPANY_AUTHORIZATION_NO=""
COMPANY_MERSIS=""
COMPANY_ADDRESS=""

# İsteğe bağlı: belge okuma (OpenAI) ve AI taslağı (Claude). Boşsa SİMÜLASYON.
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""

# İsteğe bağlı: personel bildirimleri (Web Push). Üretmek için: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT=""

# Yalnızca boş veritabanına ilk yüklemede (npm run db:seed:cloud) — her biri en az 12 karakter, birbirinden farklı
# DEMO_PASSWORD_YONETICI=""
# DEMO_PASSWORD_AHMET=""
# DEMO_PASSWORD_MEHMET=""

# WhatsApp Cloud API webhook (/api/whatsapp/webhook). Verify token: Meta'daki "Verify token" ile aynı rastgele değer.
# App secret: Meta uygulamasının (MirMotorsWP) App Settings > Basic > App Secret değeri; olay imzasını doğrular.
WHATSAPP_VERIFY_TOKEN=""
WHATSAPP_APP_SECRET=""
# WhatsApp asistanı: cevap göndermek için System User token (whatsapp_business_messaging izni) ve Ayarlar'da gösterilecek numara.
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_ASSISTANT_NUMBER=""
