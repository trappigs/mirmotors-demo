# İsteğe bağlı uyarı: healthchecks.io (veya uyumlu) kontrol adresleri. Gerçek dosya: /etc/mirmotors-yedek/izleme.env (600).
# Her işlem başlarken /start, biterken adresin kendisi, hata olursa /fail çağrılır.
# Hiç sinyal gelmezse (yedek hiç çalışmadıysa) servis kendisi e-posta ile uyarır.
HC_URL_YEREL="https://hc-ping.com/<uuid-1>"
HC_URL_UZAK="https://hc-ping.com/<uuid-2>"
HC_URL_TEST="https://hc-ping.com/<uuid-3>"
