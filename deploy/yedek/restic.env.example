# Mir Motors uzak yedek ayarı — ŞABLON. Gerçek dosya sunucuda: /etc/mirmotors-yedek/restic.env
# (sahibi root, izin 600). Gerçek değerler git'e, rapora, log'a yazılmaz.

# --- Seçenek A: Backblaze B2 (S3 uyumlu uç nokta, https) ---
RESTIC_REPOSITORY="s3:https://s3.<bolge>.backblazeb2.com/<kova-adi>/mirmotors"
AWS_ACCESS_KEY_ID="<yalniz-bu-kovaya-yetkili-application-key-id>"
AWS_SECRET_ACCESS_KEY="<application-key>"

# --- Seçenek B: Cloudflare R2 ---
# RESTIC_REPOSITORY="s3:https://<hesap-id>.r2.cloudflarestorage.com/<kova-adi>/mirmotors"
# AWS_ACCESS_KEY_ID="<yalniz-bu-kovaya-object-read-write-token-id>"
# AWS_SECRET_ACCESS_KEY="<token-secret>"

# --- Seçenek C: Hetzner Storage Box (sftp; SSH anahtarı /root/.ssh/ altında) ---
# RESTIC_REPOSITORY="sftp:<kullanici>@<kullanici>.your-storagebox.de:mirmotors"

# Şifreleme parolası ayrı dosyada (600). Bu parola kaybolursa yedekler AÇILAMAZ:
# bir kopyası sunucu dışında (parola yöneticisi) mutlaka saklanmalı.
RESTIC_PASSWORD_FILE="/etc/mirmotors-yedek/restic-parola"

# İsteğe bağlı: yükleme hız sınırı (KiB/s), varsayılan 4096
# YEDEK_UPLOAD_KBPS=4096
