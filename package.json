{
  "name": "mirmotors-demo",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "setup": "node scripts/ensure-env.mjs && node scripts/guard-local-db.mjs && prisma generate && prisma migrate deploy && tsx prisma/seed.ts",
    "db:reset": "node scripts/guard-local-db.mjs && prisma migrate deploy && tsx prisma/seed.ts",
    "db:seed:cloud": "prisma migrate deploy && tsx prisma/seed.ts --cloud",
    "demo": "npm run setup && next build && next start",
    "vercel-build": "prisma generate && prisma migrate deploy && next build",
    "e2e": "node tests/e2e-demo.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.1.0",
    "@prisma/client": "^6.19.3",
    "@vercel/blob": "^2.8.2",
    "bcryptjs": "^3.0.3",
    "jose": "^6.2.13",
    "next": "15.5.28",
    "prisma": "^6.19.3",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^24.19.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "15.5.28",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.5"
  },
  "allowScripts": {
    "@prisma/client@6.19.3": true,
    "@prisma/engines@6.19.3": true,
    "prisma@6.19.3": true
  }
}
