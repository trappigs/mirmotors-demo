# Bu dal (vercel-deploy) PostgreSQL kullanır. Yerel SQLite sürümü için master dalına geçin.
# Vercel kurulumu: VERCEL_DEPLOY.md

# --- Zorunlu ---
# Neon: Vercel Marketplace bağlantısı DATABASE_URL (havuzlu) ve DATABASE_URL_UNPOOLED (doğrudan) değişkenlerini ekler.
# Yerelde: `npx prisma dev` ile açılan yerel PostgreSQL adresi (localhost) — sıfırlama komutları yalnızca localhost'ta çalışır.
DATABASE_URL="postgres://postgres:postgres@localhost:51214/template1?sslmode=disable&connection_limit=1&pgbouncer=true"
DATABASE_URL_UNPOOLED="postgres://postgres:postgres@localhost:51214/template1?sslmode=disable&connection_limit=1&pgbouncer=true"
# Oturum imzalama anahtarı (en az 16 karakter). `npm run setup` .env yoksa rastgele üretir.
SESSION_SECRET="buraya-uzun-rastgele-bir-deger-yazin"

# --- Vercel (internete açık demo) ---
# CRM erişim kapısı (HTTP Basic). Vercel'de tanımlı değilse CRM açılmaz.
DEMO_ACCESS_USER="mirmotors"
DEMO_ACCESS_PASSWORD=""
# "all" ise müşteri sitesi de erişim şifresi ister (varsayılan: yalnızca CRM)
# DEMO_ACCESS_SCOPE="crm"
# Bulut seed'i (npm run db:seed:cloud) için personel şifresi — en az 12 karakter, yerel demo şifresinden farklı
DEMO_STAFF_PASSWORD=""
# Vercel Blob (özel mağaza) okuma-yazma anahtarı. Tanımlıysa yüklemeler doğrudan Blob'a gider; boşsa ./storage kullanılır.
BLOB_READ_WRITE_TOKEN=""

# --- İsteğe bağlı ---
# Canlı AI taslağı (Claude). Boşsa AI ekranı açıkça işaretli SİMÜLASYON modunda çalışır (Vercel'de her zaman simülasyon).
ANTHROPIC_API_KEY=""
OPENAI_API_KEY=""
# İlan sayfasındaki WhatsApp butonu için numara (ülke koduyla, yalnızca rakam). Demo değeri gerçek değildir.
NEXT_PUBLIC_WHATSAPP_NUMBER="905000000000"
# Yerelde yüklenen dosyaların kök klasörü (varsayılan: ./storage)
# STORAGE_DIR="./storage"
# Yerelde HTTPS arkasında yayınlanıyorsa 1 (Vercel'de otomatik)
# COOKIE_SECURE="1"
# FFMPEG_PATH=""
NEXT_PUBLIC_INSTAGRAM_URL=""
