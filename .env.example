# --- Zorunlu ---
# SQLite veritabanı dosyası (prisma/ klasörüne göre)
DATABASE_URL="file:./dev.db"
# Oturum imzalama anahtarı (en az 16 karakter). `npm run setup` .env yoksa rastgele üretir.
SESSION_SECRET="buraya-uzun-rastgele-bir-deger-yazin"

# --- İsteğe bağlı ---
# Canlı AI taslağı (Claude). Boşsa AI ekranı açıkça işaretli SİMÜLASYON modunda çalışır.
ANTHROPIC_API_KEY=""
# Videodaki konuşmayı metne çevirmek için ayrı servis (OpenAI Whisper). Boşsa transkript elle yapıştırılır.
OPENAI_API_KEY=""
# İlan sayfasındaki WhatsApp butonu için numara (ülke koduyla, yalnızca rakam). Demo değeri gerçek değildir.
NEXT_PUBLIC_WHATSAPP_NUMBER="905000000000"
# Yüklenen dosyaların kök klasörü (varsayılan: ./storage)
# STORAGE_DIR="./storage"
# HTTPS arkasında yayınlanıyorsa oturum çerezini Secure yapmak için 1
# COOKIE_SECURE="1"
# ffmpeg PATH'te değilse tam yolu (AI akışında videodan kare çıkarmak için, isteğe bağlı)
# FFMPEG_PATH=""
